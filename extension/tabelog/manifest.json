{
  "manifest_version": 3,
  "name": "食べログ 口コミ返信アシスタント",
  "version": "1.0.0",
  "description": "食べログ店舗管理画面の新着口コミをAIが確認し、返信欄に返信文を下書きします。送信ボタンは担当者が押します。",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://owner.tabelog.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://owner.tabelog.com/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "食べログ 口コミ返信アシスタント", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
