# Cloud Functions の設定値（公開してよい値のみ）。functions/.env にコピーして編集してください。
# 秘密の値（GOOGLE_CLIENT_SECRET / INSTAGRAM_APP_SECRET）は
# `firebase functions:secrets:set` で登録し、このファイルには書かないでください。
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Meta開発者サイトの「Instagram」→「API setup with Instagram login」画面に表示される
# 「Instagram app ID」（Facebookアプリ全体のID＝「基本設定」のApp IDとは別物）
INSTAGRAM_APP_ID=000000000000000
ALLOWED_EMAILS=kayanuma.h@kaneyamaen.co.jp
PUBLIC_BASE_URL=https://chuo-kanko-kuchikomi-ichigen-kanri.firebaseapp.com
# MetaのWebhook登録画面で「検証トークン」として入力する文字列。自分で決めてよい（推測されにくい文字列にする）
WEBHOOK_VERIFY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
